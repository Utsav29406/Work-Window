# Copy to .env (git-ignored) for local development.

# Neon Postgres connection string. Also set it in the Vercel project's environment variables.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Optional (API): extra browser origins allowed to call the API, comma-separated.
# Defaults to workwindow.web.app, foliocraft-7b89bf.web.app/.firebaseapp.com and localhost.
# ALLOWED_ORIGINS=https://workwindow.web.app,http://localhost:5173

# Frontend build for Firebase Hosting: where the API is deployed (your Vercel URL).
# Leave unset when the API is on the same origin (local dev, Vercel deployment).
# VITE_API_URL=https://your-project.vercel.app
